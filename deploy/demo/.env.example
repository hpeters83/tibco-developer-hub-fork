# Copy to `.env` and fill in. Consumed by docker-compose.yml.
# This file holds NO secrets — the demo runs with no credentials by design.

# Image published by the demo-image GitHub Actions workflow.
# Replace OWNER/REPO with your GitHub org/repo (lowercase), e.g.
#   ghcr.io/hpeters83/tibco-developer-hub-fork_demoenvironment-demo:latest
DEVHUB_IMAGE=ghcr.io/OWNER/REPO-demo:latest

# Public domain for the demo (must resolve to this host; used by Caddy for TLS).
DEMO_DOMAIN=demo.example.com

# Public base URL the browser uses. MUST end with /tibco/hub.
APP_BASE_URL=https://demo.example.com/tibco/hub
