# Caddyfile — automatic HTTPS (Let's Encrypt) for the public demo.
# DEMO_DOMAIN is supplied via the environment (see docker-compose.yml / .env).
#
# Caddy obtains and renews the TLS certificate automatically, provided the
# domain's DNS A record points at this host and ports 80/443 are reachable.

{$DEMO_DOMAIN} {
	encode gzip

	# The app is served at root (APP_BASE_URL is the bare domain): app-backend
	# rewrites the HTML <script>/<link> tags to /static/... at runtime.
	#
	# BUT font URLs inside the extracted CSS are frozen at BUILD time with the
	# build's publicPath (/tibco/hub) and are NOT rewritten at runtime. The files
	# actually live at /static/..., so remap the stale /tibco/hub/static/* paths
	# back to /static/* (covers all build-baked CSS asset URLs, not just fonts).
	handle /tibco/hub/static/* {
		uri replace /tibco/hub/static/ /static/
		reverse_proxy devhub:7007
	}

	handle {
		reverse_proxy devhub:7007
	}
}
