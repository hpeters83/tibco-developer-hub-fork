# Caddyfile — automatic HTTPS (Let's Encrypt) for the public demo.
# DEMO_DOMAIN is supplied via the environment (see docker-compose.yml / .env).
#
# Caddy obtains and renews the TLS certificate automatically, provided the
# domain's DNS A record points at this host and ports 80/443 are reachable.

{$DEMO_DOMAIN} {
	encode gzip

	# The whole product assumes it lives under /tibco/hub: the build's publicPath
	# (so extracted-CSS font URLs are /tibco/hub/static/...), the marketplace
	# TechDocs in-app links (/tibco/hub/create, /tibco/hub/import-flow, ...), and
	# the API entity `servers` URLs (/tibco/hub/api/...). So APP_BASE_URL ends with
	# /tibco/hub and the browser uses /tibco/hub/* for everything.
	#
	# The backend itself serves at root (/, /static, /api), so we strip the
	# /tibco/hub prefix before proxying — exactly what the production ingress does:
	#   /tibco/hub/static/x.woff2 -> /static/x.woff2
	#   /tibco/hub/api/...        -> /api/...
	#   /tibco/hub/create         -> /create  (SPA route; router basename=/tibco/hub)
	redir / /tibco/hub/ 308

	handle_path /tibco/hub* {
		reverse_proxy devhub:7007
	}
}
